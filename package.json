{
  "name": "contest-be",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:watch": "concurrently \"tsc --watch\" \"nodemon dist/server.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "prisma:undo-seed": "ts-node -r tsconfig-paths/register prisma/undo-seed.ts",
    "prisma:undo-seed-force": "ts-node -r tsconfig-paths/register prisma/undo-seed.ts --force",
    "prisma:undo-seed-advanced": "ts-node -r tsconfig-paths/register prisma/undo-seed-advanced.ts",
    "test:db-connection": "ts-node -r tsconfig-paths/register scripts/test-db-connection.ts",
    "docs:generate": "node scripts/generate-swagger-docs.js",
    "docs:open": "start http://localhost:3000/api/v1/docs"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "description": "Backend application with TypeScript, Express, and Prisma",
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.3",
    "prisma": "^6.8.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.22",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma-dbml-generator": "^0.12.0",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
